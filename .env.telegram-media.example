# Telegram API credentials from https://my.telegram.org
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=YOUR_API_HASH
TELEGRAM_PHONE_NUMBER=+910000000000

# BotFather token
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN

# One or more Telegram user IDs allowed to operate the bot.
# Example: 123456789,987654321
TELEGRAM_ALLOWED_USER_IDS=123456789

# Telegram user ID of the single bot owner (get it with /id in the bot)
VOROA_OWNER_USER_ID=123456789

# Persistent MongoDB state. Store the Telegram user session, login state,
# owner/VIP access and per-user destinations here.
TELEGRAM_SESSION_DB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
TELEGRAM_SESSION_DB_NAME=hj_groups_url_uploader
TELEGRAM_SESSION_COLLECTION=telegram_sessions

# Optional local mirror. /data is used for a persistent Voroa disk when available.
TELEGRAM_LOCAL_STATE_FILE=/data/voroa_session_store.json

# Optional default destination. Users can override with /setdestination.
TELEGRAM_DESTINATION=-1001234567890

# Caption branding
TELEGRAM_BRANDING=@hjgroups_1

# Bot-chat copy is deleted after this many seconds (default 60 minutes).
TELEGRAM_BOT_DELETE_SECONDS=3600

# Maximum messages scanned by one /range job.
TELEGRAM_MAX_BULK_MESSAGES=500

# Only one large transfer job at a time by default.
TELEGRAM_MAX_ACTIVE_JOBS=1
TELEGRAM_SCAN_TIMEOUT_SECONDS=35

# Temporary local download directory. Leave unset to use the system temp directory.
# TELEGRAM_TEMP_DIR=/data/telegram_tmp

# Optional local state file for per-user destinations.
TELEGRAM_STATE_FILE=/data/telegram_media_state.json

# Playbook temporary staging credentials.
PLAYBOOK_API_TOKEN=YOUR_PLAYBOOK_API_TOKEN
PLAYBOOK_ORG_SLUG=YOUR_PLAYBOOK_ORG_SLUG
