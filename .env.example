# Telegram API credentials from my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE_NUMBER=

# BotFather token
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram user IDs allowed to use the bot
TELEGRAM_ALLOWED_USER_IDS=

# Default destination chat/channel username or ID
TELEGRAM_DESTINATION=

# Optional settings
TELEGRAM_BRANDING=@hjgroups_1
TELEGRAM_BOT_DELETE_SECONDS=3600
TELEGRAM_MAX_BULK_MESSAGES=500
TELEGRAM_MAX_ACTIVE_JOBS=1
TELEGRAM_SESSION_NAME=telegram_user_session
