# Telegram API credentials from my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE_NUMBER=

# BotFather token
TELEGRAM_BOT_TOKEN=

# Allowed Telegram user IDs, comma-separated
TELEGRAM_ALLOWED_USER_IDS=

# Default destination chat/channel username or ID
TELEGRAM_DESTINATION=

# Optional per-user destinations: 123456:@dest|789012:-1001234567890
TELEGRAM_USER_DESTINATIONS=

# For hosted deployment, prefer a Telethon StringSession.
# Generate locally with: python generate_telethon_session.py
TELEGRAM_SESSION_STRING=

# Optional settings
TELEGRAM_BRANDING=@hjgroups_1
TELEGRAM_BOT_DELETE_SECONDS=3600
TELEGRAM_MAX_BULK_MESSAGES=500
TELEGRAM_MAX_ACTIVE_JOBS=1
TELEGRAM_SESSION_NAME=telegram_user_session
