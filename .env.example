# Telegram API credentials from my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# BotFather token
TELEGRAM_BOT_TOKEN=

# Access control is fail-closed. Set your Telegram numeric user ID here.
# You may also provide a comma-separated allow-list.
TELEGRAM_ALLOWED_USER_IDS=
VOROA_OWNER_USER_ID=

# Default destination chat/channel username or ID
TELEGRAM_DESTINATION=

# Hosted deployment: StringSession is preferred for reliable restarts.
# This is a Telegram user authorization credential; keep it secret.
TELEGRAM_SESSION_STRING=

# Optional persistent filesystem paths
VOROA_SESSION_FILE=/data/voroa_session.txt
VOROA_STATE_FILE=/data/voroa_state.json

# Transfer limits / UI
TELEGRAM_MAX_BULK_MESSAGES=500
VOROA_MAX_TRANSFER_FILES=100
TELEGRAM_SCAN_TIMEOUT_SECONDS=30
